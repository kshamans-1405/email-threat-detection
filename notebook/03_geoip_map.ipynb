    "reader = geoip2.database.Reader(\"../geo/GeoLite2-City.mmdb\")\n",
    "r = reader.city(\"8.8.8.8\")\n",
    "print(r.country.name, r.city.name, r.location.latitude, r.location.longitude, r.location.accuracy_radius)"
